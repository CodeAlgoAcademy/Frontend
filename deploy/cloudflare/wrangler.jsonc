{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codealgo-web",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // Escape hatch. If the custom domain is wrong or the zone is mid-move,
  // codealgo-web.<subdomain>.workers.dev still answers, which is how you tell
  // "the Worker is broken" apart from "DNS is broken".
  "workers_dev": true,

  "observability": {
    "enabled": true
  },

  // Apex and www both land here. Cloudflare creates and owns these DNS records
  // because of custom_domain: true - do not also hand-create them in the
  // dashboard or the deploy fails on a conflict.
  //
  // www is a route rather than a redirect on purpose. Next serves both fine and
  // a Bulk Redirect rule is one more thing to forget exists.
  "routes": [
    { "pattern": "codealgoacademy.com", "custom_domain": true },
    { "pattern": "www.codealgoacademy.com", "custom_domain": true }
  ],

  // Keep-warm only. A marketing site that takes eight seconds to answer the
  // first request of the morning is worse than the container cost.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  "containers": [
    {
      "class_name": "WebContainer",
      "image": "./Dockerfile",
      "image_build_context": "../..",
      // 1 GiB memory, 4 GB disk. The standalone image lands well inside that.
      // If `wrangler deploy` ever rejects the image for size, the fix is one
      // word: bump this to "standard-1" for 8 GB.
      //
      // "standard-1" (0.5 vCPU, 4 GiB) x3, to match the API.
      //
      // Node SSR was never short of memory - it peaked at 727 MB of the 1 GiB
      // "basic" gave it - so most of this is buying the CPU that comes bundled
      // with the tier. Measured at ~201ms of container CPU per rendered
      // request, and the single 0.25 vCPU container hit 100% on ordinary days,
      // not just during the incident: 2026-08-21 18:00Z, 20:00Z, 08-22 03:00Z,
      // 08-23 08:00Z and 20:00Z all pegged with nobody complaining. That is the
      // headroom that was not there when a class arrived.
      "instance_type": "standard-1",
      // Next is stateless here - no sessions on the server, no in-memory cache
      // anyone reads twice - so it scales out, and now it does.
      //
      // One instance meant every page render for every school queued behind
      // one container on a quarter of a core. When it was busy the site did
      // not get slow, it stopped answering, which is the "could not access
      // parts of the site" half of the incident: nothing reached the API at
      // all, so the API's own logs show a quiet day.
      //
      // Three is a starting point, not a measurement. Note the keep-warm cron
      // in src/index.ts now pokes all three, so all three stay running and all
      // three bill - that is the trade for nobody paying a cold start. Drop
      // this and the INSTANCES constant in src/index.ts together if the cost
      // is not worth it; they have to agree.
      "max_instances": 3
    }
  ],

  "durable_objects": {
    "bindings": [{ "name": "WEB_CONTAINER", "class_name": "WebContainer" }]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WebContainer"]
    }
  ],

  "vars": {
    "NODE_ENV": "production",
    // Read server-side by pages/api/teachers/class/[classId]/print-student-logins,
    // which builds the QR login URLs on the student handout. Not a NEXT_PUBLIC_
    // value, so it is genuinely runtime config and belongs here.
    "URL_GAME": "https://play.codealgoacademy.com",
    // Server-side API route (print-student-logins) reads NEXT_PUBLIC_API_URL from
    // process.env at RUNTIME. Next only inlines NEXT_PUBLIC_* into the client
    // bundle at build time; the container's node server gets nothing unless we
    // pass it here. Without this the route calls its own origin and 404s.
    "NEXT_PUBLIC_API_URL": "https://prod-api.codealgoacademy.com/"
  }
}
